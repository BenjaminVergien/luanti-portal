APP_NAME="Luanti Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE
APP_TIMEZONE=Europe/Berlin

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=1300

CACHE_STORE=database
# CACHE_PREFIX=

# Invitation locks and quotas must use a shared cache store.
INVITATION_CACHE_STORE=database
INVITATION_ACTOR_PER_MINUTE=10
INVITATION_ACTOR_PER_HOUR=50
INVITATION_ORGANIZATION_PER_HOUR=100
INVITATION_RECIPIENT_PER_HOUR=3
INVITATION_RECIPIENT_PER_DAY=5
INVITATION_GLOBAL_PER_MINUTE=50
INVITATION_GLOBAL_PER_HOUR=500

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_TIMEOUT=15
MAIL_AUTO_TLS=true
MAIL_REQUIRE_TLS=true
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Only used by the local development seeder. Never commit a real password.
DEV_ADMIN_EMAIL=dev@example.test
DEV_ADMIN_PASSWORD=

# Optional fallback until a token is saved in /admin/einstellungen.
# Use a Read & Write token from the Hetzner Cloud project voxelgarden.
HETZNER_API_TOKEN=

# Optional path to OpenSSH on the portal host (detected for Windows/Linux).
# SSH_BINARY=/usr/bin/ssh
